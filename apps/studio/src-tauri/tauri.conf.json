{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AlphaBuilder Studio",
  "version": "4.0.0",
  "identifier": "com.alphabuilder.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AlphaBuilder Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "dragDropEnabled": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Generative structural design studio",
    "longDescription": "AlphaBuilder Studio — Tauri v2 desktop inspector and generative structural design studio for v3.3 datasets."
  }
}
